# ---- Server ----
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed origins for CORS (use * only in dev)
CORS_ORIGINS=*

# ---- Database ----
# Local:   mongodb://127.0.0.1:27017/echo
# Atlas:   mongodb+srv://<user>:<pass>@<cluster>/echo?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/echo

# ---- JWT ----
# Generate strong random secrets, e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_TTL=30d

# ---- Google Sign-In (free) ----
# One or more OAuth client IDs (web / android / ios), comma-separated. Leave blank to disable.
GOOGLE_CLIENT_IDS=

# ---- Advisor LLM layer (optional, pay-per-use) ----
# Leave ANTHROPIC_API_KEY blank to run the Advisor in free rules-only mode.
ANTHROPIC_API_KEY=
# Default is the most capable model. For lower cost set claude-sonnet-5 or claude-haiku-4-5.
ANTHROPIC_MODEL=claude-opus-5

# ---- OTP / SMS (pluggable) ----
# console = free dev provider (logs OTP to server console). Future: twilio, msg91, email.
SMS_PROVIDER=console
OTP_TTL_SECONDS=300

# ---- Market data (live prices) ----
# Free-tier provider config; leave blank to use the built-in mock provider.
PRICE_PROVIDER=mock
PRICE_API_KEY=
